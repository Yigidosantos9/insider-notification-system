# Copy to .env and adjust. All values shown are the defaults.
DATABASE_URL=postgres://notifier:notifier@localhost:5432/notifier?sslmode=disable
HTTP_ADDR=:8080
METRICS_ADDR=:9091
# Local mock provider by default; set to https://webhook.site/<your-uuid> for the real simulation.
PROVIDER_URL=http://localhost:9090/send
PROVIDER_TIMEOUT=5s
RATE_LIMIT_PER_SECOND=100
WORKER_CONCURRENCY=20
CLAIM_BATCH=50
MAX_ATTEMPTS=5
RETRY_BASE=2s
RETRY_CAP=5m
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN=30s
LOG_LEVEL=info
